{
  "compilerOptions": {
    // Module and target
    "module": "commonjs",
    "target": "es2020",

    // File outputs
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Strict type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // JSX support
    "jsx": "react-jsx",

    // Node.js typings
    "types": [ "node" ],

    // Misc
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": [ "src" ],
  "exclude": [ "node_modules", "dist" ]
}